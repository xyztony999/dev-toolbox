{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dev-toolbox",
  "compatibility_date": "2026-03-22",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "dev-toolbox.tonyxyz.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
